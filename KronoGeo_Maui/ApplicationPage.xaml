<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:carousel="clr-namespace:KronoGeo_Maui.Applications.Outils.Views"
             xmlns:viewmodels="clr-namespace:KronoGeo_Maui.ModelViews"
             xmlns:models="clr-namespace:KronoGeo_Api.Models.Model.DTO;assembly=KronoGeo_Api.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:KronoGeo_Maui.Applications.Helpers"
             xmlns:behaviors="clr-namespace:KronoGeo_Maui.Applications.Behaviors"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:DataType="viewmodels:ApplicationPageViewModel"
             x:Class="KronoGeo_Maui.ApplicationPage"
             Title="KronoGeo"
             x:Name="KronoGeoPage"
             Shell.BackgroundColor="#F9EDE1"
             Shell.TitleColor="#51638B"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}">
    

    <!-- ToolBar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding BarItemParamCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons-Regular" Glyph="&#xe7fd;" Color="#51638B"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Command="{Binding BarItemCloseCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons-Regular" Glyph="&#xe8ac;" Color="#51638B"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <VerticalStackLayout BackgroundColor="#96BD8E" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5" />
            </Grid.ColumnDefinitions>
            <!--<CarouselView Grid.Column="1" Grid.Row="0" MinimumHeightRequest="600" 
                HeightRequest="650" ItemsSource="{Binding MesPages}"
                ItemTemplate="{StaticResource KronoGeoTemplate}"
                Loop="False">-->
                <!--InputTransparent="True" VerticalOptions="End"-->
            <!--</CarouselView>-->

            <!-- Affichage de la map et du tracé -->
            <maps:Map Grid.Row="0" Grid.Column="1"  x:Name="googleMap"  
                    MinimumHeightRequest="600" HeightRequest="630"
                    IsShowingUser="True" MapType="{Binding MapType}"
                    IsScrollEnabled="True" IsZoomEnabled="True">
                    <maps:Map.Behaviors>
                        <!-- Le behavior écoute le Messenger en silence -->
                        <behaviors:MapMessengerBehavior />
                        <behaviors:PolyneMessengerBehavior/>
                        <behaviors:PinMessengerBehavior/>
                    </maps:Map.Behaviors>
                </maps:Map>

            <Border Grid.Row="1" Grid.Column="1" StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20,20,20,20" Stroke="#51638B">
                <Grid VerticalOptions="End" BackgroundColor="#F9EDE1" HeightRequest="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" FontFamily="MaterialIcons-Regular" 
                            Text="{Binding PlayPause}"  TextColor="#51638B" 
                            FontSize="30" BackgroundColor="#F9EDE1" 
                            Command="{Binding StartPauseCommand}"/>
                    <Button Grid.Column="1" FontFamily="MaterialIcons-Regular" 
                            Text="&#xef71;" TextColor="#51638B" FontSize="30"
                            BackgroundColor="#F9EDE1" Command="{Binding StopCommand}"/>
                    <Button Grid.Column="2" FontFamily="MaterialIcons-Regular" 
                            Text="&#xe3af;" TextColor="#51638B" FontSize="30"
                            BackgroundColor="#F9EDE1" IsEnabled="{Binding IsEnablePhoto}" 
                            IsVisible="{Binding IsEnablePhoto}"
                            Command="{Binding  TakePhotoCommand}"/>
                </Grid>
            </Border>
            <HorizontalStackLayout Grid.Column="1" Grid.Row="2" 
                                   HorizontalOptions="Center" BackgroundColor="Transparent">
                <Button FontFamily="MaterialIcons-Regular" Text="&#xe316;" FontSize="40"
                        TextColor="LightGray" BackgroundColor="Transparent" VerticalOptions="Start"
                        Command="{Binding OpenButtomSheetCommand}"/>
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>