<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KronoGeo_Maui.ModelViews"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:KronoGeo_Maui.Applications.Helpers"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:DataType="viewmodels:ApplicationPageViewModel"
             x:Class="KronoGeo_Maui.ApplicationPage"
             Title="KronoGeo"
             Shell.BackgroundColor="#F9EDE1"
             Shell.TitleColor="#51638B"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}"
             Shell.TabBarTitleColor="#51638B">
    
    <!-- ToolBar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding ToolbarItemCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons-Regular" Glyph="&#xe8ac;" Color="#51638B"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView BackgroundColor="#96BD8E" >
        
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <!--<RowDefinition Height="50" />-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
            <Label Text="{Binding Message}" TextColor="Red" FontSize="14"/>
            <maps:Map Grid.Column="1" Grid.Row="1" MinimumHeightRequest="600" HeightRequest="650"
                    x:Name="googleMap" IsShowingUser="True"
                     IsScrollEnabled="True" IsZoomEnabled="True"/>

            </Grid>

        

    </ScrollView>
</ContentPage>