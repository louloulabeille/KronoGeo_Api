<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KronoGeo_Maui.ModelViews"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:ParametragePageViewModel"
             x:Class="KronoGeo_Maui.ParametragePage"
             Title="Parametrage"
             Shell.BackgroundColor="#F9EDE1"
             Shell.TitleColor="#51638B"
             Shell.TabBarIsVisible="False">

    <VerticalStackLayout BackgroundColor="#96BD8E">
        <HorizontalStackLayout>
            <Label Text="Connexion par biometrie" HorizontalOptions="Start"></Label>
            <Switch IsToggled="{Binding IsBiometric}" HorizontalOptions="End" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>