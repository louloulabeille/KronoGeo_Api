<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KronoGeo_Maui.ModelViews"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:ParametragePageViewModel"
             x:Class="KronoGeo_Maui.ParametragePage"
             Title="Parametrage"
             Shell.BackgroundColor="#F9EDE1"
             Shell.TitleColor="#51638B"
             Shell.TabBarIsVisible="True">

    <VerticalStackLayout BackgroundColor="#96BD8E" Padding="10" >    
        <HorizontalStackLayout Padding="5">
            <Label Text="Connexion par biometrie" FontSize="16"
                   HorizontalOptions="Start" VerticalOptions="Center"></Label>
            <Switch IsToggled="{Binding IsBiometric}" HorizontalOptions="End" 
                    VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Border StrokeThickness="1" StrokeShape="RoundRectangle 10,10,10,10"
                Stroke="#51638B" Margin="5">
            <VerticalStackLayout Margin="5">
                <Label Text="Unité de mesure" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center"></Label>
                <HorizontalStackLayout>
                    <Label Text="kilomètres" FontSize="16"
                           VerticalOptions="Center"></Label>
                    <Switch IsToggled="{Binding IsMetric}" 
                            VerticalOptions="Center" HorizontalOptions="End" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="miles" FontSize="16" 
                           VerticalOptions="Center"></Label>
                    <Switch IsToggled="{Binding IsMiles}" HorizontalOptions="End" 
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <!-- ajout d'élements qui sera affiché selon la version de IOS ici Android >= API-26 -->
        <HorizontalStackLayout Padding="5" IsEnabled="{Binding IsEnableLocationManager}" 
                               IsVisible="{Binding IsEnableLocationManager}">
            <Label Text="Fused" FontSize="16" HorizontalOptions="Start" VerticalOptions="Center"
                   AutomationProperties.HelpText="Fused fusionne toutes les sources (gps, wifi, gsm etc) possibles pour faire la géolocalisation - Attention en plein nature et Google play services obligatoire."
                   ToolTipProperties.Text="Fused fusionne toutes les sources (gps, wifi, gsm etc) possibles pour faire la géolocalisation - Attention en plein nature et Google play services obligatoire."/>
            <Switch IsToggled="{Binding IsLocationManager}" HorizontalOptions="End" VerticalOptions="Center"
                    AutomationProperties.HelpText="Choix entre 2 systèmes de géolocalisation pour Android."
                    ToolTipProperties.Text="Choix entre 2 systèmes de géolocalisation pour Android."/>
            <Label Text="Location Manager" FontSize="16" VerticalOptions="Center" HorizontalOptions="End"
                   AutomationProperties.HelpText="Utilise le Gps en haute précision mais la consommation est plus important."
                   ToolTipProperties.Text="Utilise le Gps en haute précision mais la consommation est plus important."/>
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>