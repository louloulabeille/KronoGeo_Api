<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KronoGeo_Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KronoGeo_Maui"
    Title="KronoGeo_Maui">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <TabBar>
        <Tab Title="Start" Icon="{FontImageSource FontFamily=MaterialIcons-Regular,Glyph='#e3e3e3',Color='#51638B'}">
            <ShellContent ContentTemplate="{DataTemplate local:ApplicationPage}"/>
        </Tab>
        <Tab Title="Stop" Icon="{FontImageSource FontFamily=MaterialIcons-Regular,Glyph='#e3e3e3',Color='#51638B'}">
            <ShellContent ContentTemplate="{DataTemplate local:ApplicationPage}"/>
        </Tab>
        <Tab Title="Camera" Icon="{FontImageSource FontFamily=MaterialIcons-Regular,Glyph='#e3e3e3',Color='#51638B'}">
            <ShellContent ContentTemplate="{DataTemplate local:ApplicationPage}"/>
        </Tab>
        <Tab Title="Paramètre" >
            <ShellContent ContentTemplate="{DataTemplate local:ApplicationPage}"/>
        </Tab>
    </TabBar>
</Shell>
