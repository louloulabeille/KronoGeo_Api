<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
           x:Class="KronoGeo_Maui.PageHelpers.PopupBatterySaverPage">
    
    <VerticalStackLayout>
        <Border StrokeShape="RoundRectangle 90,90,90,90" StrokeThickness="1" BackgroundColor="#F9EDE1">
            <VerticalStackLayout>
                <Label 
                    Text="En raison de la mise en place du système d'économie d'énergie sur votre téléphone. 
                    Le système de géolocalisation va perdre énormement en précision."
                    VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"
                    TextColor="#51638B"
                    />
                <Label 
                    Text="La fenêtre de configuration d'énergie va s'ouvrir, pour le désactiver au lancement de la géolocalisation et lors de l'arrêt pour le remettre.
                    Il est possible de le faire que m'annuellement, veuillez nous en excuser."
                    VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"
                    TextColor="#51638B"
                    />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</mct:Popup>