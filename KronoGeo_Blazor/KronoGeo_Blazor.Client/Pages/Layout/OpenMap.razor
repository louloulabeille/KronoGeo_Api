@inherits OpenMapBase

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="container">

    <div class="row" style="position: relative; width: 100%; height:100%">
        
        <!-- carte openstreetmap -->
        <div class="col border rounded p-2 canvas-container" @onpointermove="HandlerPointerMove">
            <MapControlComponent @ref="MapControl"  />
        </div>

        <!-- card image et affichage des informations de l'image-->
        @if (IsHovered && !string.IsNullOrEmpty(UrlImg) && !IsCluster)
        {
            <!--18rem-->
            <div class="card" style="width:280px; top:@($"{(MouseY + 40).ToString("0", CultureInfo.InvariantCulture)}px");
                left:@($"{(MouseX - 140).ToString("0", CultureInfo.InvariantCulture)}px"); z-index: 9999; pointer-events: auto;position : absolute;">
                <button type="button" class="btn-close" aria-label="Close" @onclick="HandlerCloseCard" 
                    style="pointer-events: auto;"></button>
                <img src="@UrlImg" class="card-img-top" alt="...">
                <div class="card-body">
                    <p class="card-text">
                        <table class="table table-primary table-striped ">
                            <tbody>
                                <tr>
                                    <th scope="row" colspan="2">
                                        <p style="font-size: small">
                                            Description
                                        </p>
                                    </th>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                    @if ( IsDescription ) {
                                        <textarea @bind="Description" class="form-control" 
                                            style="font-size: small" rows="3">
                                        </textarea>
                                    }
                                    else
                                    {
                                        <p style="font-size: small">@LocalisationPhoto?.Description</p>
                                    }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Date/heure</p></th>
                                    <td><p style="font-size: small">@ImgDate</p></td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Longitude</p></th>
                                    <td><p style="font-size: small">@ImgLongitude</p></td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Latitude</p></th>
                                    <td><p style="font-size: small">@ImgLatitude</p></td>
                                </tr>
                                <tr>
                                    <td scope="row" colspan="2">
                                        <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                                            <button @onclick="EditDescription" class="btn btn-outline-secondary">
                                            @if (IsDescription)
                                            {
                                                <i style="width:16px; height:16px" class="bi bi-floppy"></i>
                                            }
                                            else
                                            {
                                                <i style="width:16px; height:16px" class="bi bi-pencil"></i>
                                            }
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="DeletePhoto">
                                                <i style="width:16px; height:16px" class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </p>
                </div>
            </div>
        }
        <!-- fin card -->

        <!-- debut card pour afficher le cluster -->
        @if( IsCluster && !IsHovered && ClusterCard is not null) {
            <div class="card" style="width:310px; top:@($"{(MouseY + 40).ToString("0", CultureInfo.InvariantCulture)}px");
                left:@($"{(MouseX - 150).ToString("0", CultureInfo.InvariantCulture)}px"); z-index: 9999; pointer-events: auto;position : absolute;">
                <button type="button" class="btn-close" aria-label="Close" @onclick="HandlerCloseCard"
                        style="pointer-events: auto;">
                </button>
                <div class="card-body">
                    <div id="carouselControls" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner fs-6">
                        @{
                                int i = 1;
                        }
                        @foreach(var item in ClusterCard.Pins )
                        {
                            @if ( string.IsNullOrEmpty(item.Path) ) continue;
                            <div class="carousel-item @(i==1?"active":"")">
                            @{
                                        string title = $"{item.ToString()}";
                                        string pageCar = $"{i}/{ClusterCard.Count}";
                                        i++;
                            }
                                <img src="@item.Path" class="d-block w-100" alt="@item.Name">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>@title</p>
                                    @if(!string.IsNullOrEmpty(item.Description)){
                                        <p>@item.Description</p>
                                    }
                                    @*<p>@item.PinCoordonnee.ToString()</p>*@
                                    <p><strong>@pageCar</strong></p>
                                </div>
                            </div>
                        }
                         
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselControls" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselControls" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        <!-- fin affichage des clusters -->

    </div>
</div>
