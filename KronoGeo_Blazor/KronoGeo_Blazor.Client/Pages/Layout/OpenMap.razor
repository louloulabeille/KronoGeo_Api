@inherits OpenMapBase

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="container">

    <div class="row" style="position: relative; width: 100%; height:100%">
        
        <!-- carte openstreetmap -->
        <div class="col border rounded p-2 canvas-container" @onpointermove="HandlerPointerMove">
            <MapControlComponent @ref="MapControl"  />
        </div>

        <!-- card image et affichage des informations de l'image-->
        @if (IsHovered && !string.IsNullOrEmpty(UrlImg))
        {
            <!--18rem-->
            <div class="card" style="width: 250px; top: @($"{MouseY + 40.0}px"); 
                left: @($"{MouseX - 10.0}px"); z-index: 9999; pointer-events: auto;position : absolute;">
                <button type="button" class="btn-close" aria-label="Close" @onclick="HandlerCloseCard" 
                    style="pointer-events: auto;"></button>
                <img src="@UrlImg" class="card-img-top" alt="...">
                <div class="card-body">
                    <p class="card-text">
                        <table class="table table-primary table-striped ">
                            <tbody>
                                <tr>
                                    <th scope="row" colspan="2">
                                        <p style="font-size: small">
                                            Description
                                        </p>
                                    </th>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                    @if ( IsDescription ) {
                                        <textarea @bind="Description" class="form-control" 
                                            style="font-size: small" rows="3">
                                        </textarea>
                                    }
                                    else
                                    {
                                        <p style="font-size: small">@LocalisationPhoto?.Description</p>
                                    }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Date/heure</p></th>
                                    <td><p style="font-size: small">@ImgDate</p></td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Longitude</p></th>
                                    <td><p style="font-size: small">@ImgLongitude</p></td>
                                </tr>
                                <tr>
                                    <th scope="row"><p style="font-size: small">Latitude</p></th>
                                    <td><p style="font-size: small">@ImgLatitude</p></td>
                                </tr>
                                <tr>
                                    <td scope="row">
                                        <button @onclick="DeletePhoto" class="btn btn-primary-outline btn-sm">
                                            <i style="width:16px; height:16px" class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                    <td class="text-end">
                                        <button @onclick="EditDescription" class="btn btn-primary-outline btn-sm">
                                        @if (IsDescription)
                                        {
                                            <i style="width:16px; height:16px" class="bi bi-floppy"></i>
                                        }
                                        else
                                        {
                                            <i style="width:16px; height:16px" class="bi bi-pencil"></i>
                                        }
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </p>
                </div>
            </div>
        }
        <!-- fin card -->

    </div>
</div>
