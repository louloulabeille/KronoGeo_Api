@inherits RouteTelemetryViewBase

@if( Telemetry is not null)
{
    <table class="table-primary table-striped">
        <tbody>
            <tr class="table-primary">
                <th class="table-primary" scope="row">Distance</th>
                <th class="table-primary">@Distance</th>
            </tr>
            <tr>
                <th class ="table-primary" scope="row">Vitesse moyenne</th>
                <td class="table-primary">@AverageSpeed</td>
            </tr>
            <tr>
                <th class="table-primary" scope="row">Elévation positive</th>
                <td class="table-primary">@PositiveElevationGain</td>
            </tr>
            <tr>
                <th class="table-primary" scope="row">Elévation négative</th>
                <td class="table-primary">@NegativeElevationGain</td>
            </tr>
            <tr>
                <th class="table-primary" scope="row">Date de début</th>
                <td class="table-primary">@DateTimeBegin</td>
            </tr>
            <tr>
                <th class="table-primary" scope="row">Date de fin</th>
                <td class="table-primary">@DateTimeEnd</td>
            </tr>
            <tr>
                <th class="table-primary" scope="row">Durée</th>
                <td class="table-primary">@TotalTime</td>
            </tr>
            <tr>
                <th scope="row">Temps de pause</th>
                <td>@TotalTimePaused</td>
            </tr>
        </tbody>
    </table>
}
