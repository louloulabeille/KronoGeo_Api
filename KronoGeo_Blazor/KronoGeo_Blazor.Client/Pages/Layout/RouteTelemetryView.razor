@inherits RouteTelemetryViewBase

@if( Telemetry is not null)
{
    <table class="table">
        <!--
        <thead>
            <tr>
                <th scope="col">Distance</th>
                <th scope="col">Vitesse moyenne</th>
                <th scope="col">Positive élévation</th>
                <th scope="col">Négative élévation</th>
                <th scope="col">Début</th>
                <th scope="col">Fin</th>
            </tr>
        </thead>
        -->
        <tbody>

            <tr>
                <th scope="row">Distance</th>
                <th>@Distance</th>
            </tr>
            <tr>
                <th scope="row">Vitesse moyenne</th>
                <td>@AverageSpeed</td>
            </tr>
            <tr>
                <th scope="row">Elévation positive</th>
                <td>@PositiveElevationGain</td>
            </tr>
            <tr>
                <th scope="row">Elévation négative</th>
                <td>@NegativeElevationGain</td>
            </tr>
            <tr>
                <th scope="row">Date de début</th>
                <td>@DateTimeBegin</td>
            </tr>
            <tr>
                <th scope="row">Date de fin</th>
                <td>@DateTimeEnd</td>
            </tr>
            <tr>
                <th scope="row">Durée</th>
                <td>@TotalTime</td>
            </tr>
            <tr>
                <th scope="row">Temps de pause</th>
                <td>@TotalTimePaused</td>
            </tr>
        </tbody>
    </table>
}
