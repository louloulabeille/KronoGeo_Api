@page "/map"

@attribute [Authorize]

@inherits MapBase

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender:false))

@if (IsLoading)
{
    <Loader>Le chargement peut être un peu long.</Loader>
}
else
{
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                @if (DataOnView is null || DataOnView.Count() == 0)
                {
                    <Loader>Aucun groupe de localisation disponible.</Loader>
                }
                else
                {
                    <div class="accordion overflow-y-auto" id="accordionGroupLocation">
                        @foreach (var item in DataOnView.OrderByDescending(l => l.Id))
                        {
                            var headingId = $"heading{item.Id}";
                            var collapseId = $"collapse{item.Id}";
                            var titre = $"{item.Name[0].ToString().ToUpper() + item.Name.Substring(1)} - {item.Date.LocalDateTime.ToString("dd/MM/yyyy")}";
                            
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                        @titre
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#accordionGroupLocation">
                              <div class="accordion-body">
                                <RouteTelemetryView Telemetry="@item.RouteTelemetry"></RouteTelemetryView>
                              </div>
                            </div>
                          </div>

                        }
                    </div>
                    
                        <nav aria-label="Page navigation example">
                            <ul class="pagination">
                                <li class="page-item">
                                    <a class="page-link" href="#" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                            </li>
                            @if (TotalPages >= 3)
                            {
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                            }
                            else
                            {
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            }
                            <li class="page-item">
                                    <a class="page-link" href="#" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    
                }
            </div>
            <div class="col-md-8">
                <OpenMap />
            </div>
        </div>
    </div>
}


