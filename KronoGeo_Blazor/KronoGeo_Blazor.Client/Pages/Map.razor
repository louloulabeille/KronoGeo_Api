@page "/map"

@attribute [Authorize]

@inherits MapBase

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender:false))

@if (IsLoading)
{
    <Loader>Le chargement peut être un peu long.</Loader>
}
else
{
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                @if (LocalisationGroup is null || LocalisationGroup.Count == 0 )
                {
                    <p>Aucun groupe de localisation disponible.</p>
                }
                else
                {
                    @foreach (var item in LocalisationGroup.OrderByDescending(l=>l.Date))
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                            </div>
                        </div>
                    }
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">
                            <li class="page-item">
                                <a class="page-link" href="#" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
            <div class="col-md-8">
                <OpenMap />
            </div>
        </div>
    </div>
}


