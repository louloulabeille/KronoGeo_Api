@page "/account/gestionAccount"

@inherits GestionAccountBase
@rendermode InteractiveServer

@if (@DataOnView is not null)
{
    <div class="container">
        <div class="input-group flex-nowrap">
            <span class="input-group-text" id="addon-wrapping"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Recherche"
                   aria-label="Recherche" aria-describedby="addon-wrapping"
                   @bind="Search" @bind:event="oninput" @bind:after="FilterSearch" />
        </div>
        <table class="table table-striped table-Primary">
            <thead>
                <tr>
                    <th scope="col">Login</th>
                    <th scope="col">Email</th>
                    <th scope="col">N° de téléphone</th>
                    <th scope="colgroup">User</th>
                    <th scope="colgroup">Admin</th>
                    <th scope="colgroup">Manager</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in DataOnView)
                {
                    <tr>
                        @if ( item is not null && item.Id is not null )
                        {
                            <th scope="row">@item.Login</th>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td class="text-start">
                                <input class="form-check-input" type="checkbox" checked disabled>
                            </td>
                            <td class="text-start">
                                @*<InputCheckbox class="form-check-input" checked="@item.IsAdmin" />*@
                                <input class="form-check-input" type="checkbox" checked="@item.IsAdmin" 
                                    @onchange="(e) => OnUserRolesChanged(item, (bool)e.Value!, 1)" />
                            </td>
                            <td class="text-start">
                                @*<InputCheckbox class="form-check-input" checked="@item.IsManager" />*@
                                <input class="form-check-input" type="checkbox" checked="@item.IsManager" 
                                     @onchange="(e) => OnUserRolesChanged(item, (bool)e.Value!, 2)" />
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="boutton d'administration">
                                    <button type="button" @onclick="() => OnDeleteUSer(item)" 
                                        class="btn btn-outline-secondary">
                                        <i style="width:12px; height:12px" class="bi bi-trash"></i>
                                    </button>
                                    <button type="button" @onclick="() => OnSaveUser(item)" class="btn btn-outline-secondary" disabled="@DesabledSaveUser[item.Id ?? string.Empty]">
                                        <i style="width:12px; height:12px" class="bi bi-floppy"></i>
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Page navigation" class="justify-content-center">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" @onclick="() => ChangePage(1)" aria-label="Next">
                        <i class="bi bi-arrow-bar-left"></i>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" @onclick="PreviousPage" disabled="@DisabledPreviousPage" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageindex = i;
                    if (PageActuel == pageindex || (PageActuel == 1 && pageindex <= 2)
                        || (PageActuel == TotalPages && pageindex >= TotalPages - 1)
                        || (PageActuel > 1 && (pageindex == PageActuel - 1) || (pageindex == PageActuel + 1)))
                    {
                        <li class="page-item"><a class="page-link @(pageindex == PageActuel ? "active" : "")" @onclick="() => ChangePage(pageindex)">@pageindex</a></li>
                    }
                }
                <li class="page-item">
                    <a class="page-link" @onclick="NextPage" disabled="@DisabledNextPage" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link" @onclick="() => ChangePage(TotalPages)" aria-label="Next">
                        <i class="bi bi-arrow-bar-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}



